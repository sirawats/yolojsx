{
  "name": "rtifact",
  "version": "1.0.0",
  "description": "Turn agent-authored JSX into portable, interactive HTML artifacts.",
  "type": "module",
  "bin": {
    "rtifact": "lib/bin.js"
  },
  "files": [
    "lib",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "cli": "tsx src/bin.ts",
    "dev": "tsx scripts/dev.ts website/index.tsx rtifact",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "tsx --test --test-concurrency=1 test/unit/*.test.ts test/integration/*.test.ts",
    "test:unit": "tsx --test --test-concurrency=1 test/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "check": "tsc",
    "check:licenses": "tsx scripts/check-licenses.ts",
    "pack:check": "tsx scripts/pack-check.ts",
    "readiness": "tsx scripts/check-readiness.ts",
    "lint:branch": "tsx scripts/check-branch-name.ts",
    "version:check": "tsx scripts/sync-versions.ts --check",
    "verify:package": "tsx scripts/verify-package.ts",
    "verify": "tsx scripts/verify.ts",
    "version": "tsx scripts/sync-versions.ts",
    "prepack": "npm run build",
    "prepare": "node .husky/install.mjs",
    "prepublishOnly": "npm run verify && npm run readiness"
  },
  "keywords": [
    "jsx",
    "artifact",
    "html-artifact",
    "react",
    "vite",
    "tailwindcss",
    "antd",
    "cli"
  ],
  "license": "MIT",
  "author": "sirawats",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sirawats/rtifact.git"
  },
  "homepage": "https://github.com/sirawats/rtifact#readme",
  "bugs": {
    "url": "https://github.com/sirawats/rtifact/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.4",
    "antd": "^6.5.1",
    "prism-themes": "^1.9.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "semver": "^7.8.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "10.0.1",
    "@types/node": "^20.19.43",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "husky": "^9.1.7",
    "prettier": "3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
