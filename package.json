{
  "name": "yolojsx",
  "version": "0.1.4",
  "description": "Build a JSX component into portable compressed HTML or deployable React assets with Vite, Tailwind CSS, and Ant Design.",
  "type": "module",
  "bin": {
    "yolojsx": "bin/yolojsx.js"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node scripts/dev.js website/index.jsx",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test --test-concurrency=1 test/unit/*.test.js test/integration/*.test.js",
    "test:unit": "node --test --test-concurrency=1 test/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.js",
    "check": "node scripts/check-syntax.js",
    "check:licenses": "node scripts/check-licenses.js",
    "pack:check": "node scripts/pack-check.js",
    "readiness": "node scripts/check-readiness.js",
    "lint:branch": "node scripts/check-branch-name.js",
    "version:check": "node scripts/sync-versions.js --check",
    "verify:package": "node scripts/verify-package.js",
    "verify": "node scripts/verify.js",
    "version": "node scripts/sync-versions.js",
    "prepare": "node .husky/install.mjs",
    "prepublishOnly": "npm run verify && npm run readiness"
  },
  "keywords": [
    "jsx",
    "react",
    "vite",
    "tailwindcss",
    "antd",
    "cli"
  ],
  "license": "MIT",
  "author": "sirawats",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sirawats/yolojsx.git"
  },
  "homepage": "https://github.com/sirawats/yolojsx#readme",
  "bugs": {
    "url": "https://github.com/sirawats/yolojsx/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.4",
    "antd": "^6.5.1",
    "prism-themes": "^1.9.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "semver": "^7.8.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "globals": "17.7.0",
    "husky": "^9.1.7",
    "prettier": "3.9.6"
  }
}
