{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "react", "react-dom", "vite/client"]
  },
  "include": [
    ".opencode/**/*.d.mts",
    ".husky/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "src/themes/**/*.jsx",
    "test/**/*.ts",
    "website/**/*.tsx"
  ]
}
